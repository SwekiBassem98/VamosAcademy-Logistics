// VAMOS ACADEMY — schéma de gestion du centre
// Montants en millimes (Int) : 45,000 DT = 45000.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── Sécurité ─────────────

enum Role {
  ADMIN
  RESPONSABLE // responsable administratif
  COMPTABLE
  ENSEIGNANT
  LECTURE // lecture seule
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  fullName     String
  passwordHash String
  role         Role
  active       Boolean    @default(true)
  failedLogins Int        @default(0)
  lockedUntil  DateTime?
  lastLoginAt  DateTime?
  teacherId    String?    @unique
  teacher      Teacher?   @relation(fields: [teacherId], references: [id])
  sessions     Session[]
  auditLogs    AuditLog[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // ex. "student.create", "payment.cancel"
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// ───────────── Paramètres ─────────────

model CenterSettings {
  id            Int      @id @default(1)
  name          String   @default("VAMOS ACADEMY")
  addressFr     String   @default("Rue de Gaza, Cité Riadh, Kelibia")
  addressAr     String   @default("نهج غزة، حي الرياض، قليبية")
  phone         String   @default("20 807 657")
  email         String?
  receiptFooter String   @default("Merci de votre confiance. VAMOS ACADEMY… طريقك نحو النجاح")
  updatedAt     DateTime @updatedAt
}

model SchoolYear {
  id            String    @id @default(cuid())
  label         String    @unique // "2026-2027"
  startDate     DateTime
  endDate       DateTime
  // Mois facturés, au format "AAAA-MM"
  billingMonths String[]
  dueDay        Int       @default(10) // jour limite de paiement du mois
  active        Boolean   @default(false)
  groups        Group[]
  payments      Payment[]
  expenses      Expense[]
  feeRules      FeeRule[]
  createdAt     DateTime  @default(now())
}

// ───────────── Structure pédagogique ─────────────

model Cycle {
  id       String         @id @default(cuid())
  name     String         @unique // Primaire, Collège, Secondaire
  nameAr   String?
  order    Int
  levels   Level[]
  teachers TeacherCycle[]
  feeRules FeeRule[]
}

model Level {
  id       String    @id @default(cuid())
  cycleId  String
  cycle    Cycle     @relation(fields: [cycleId], references: [id])
  name     String // "9e année de base"
  order    Int
  groups   Group[]
  students Student[]
  feeRules FeeRule[]

  @@unique([cycleId, name])
}

model Subject {
  id       String           @id @default(cuid())
  code     String           @unique
  name     String
  color    String           @default("#C1272D")
  groups   Group[]
  teachers TeacherSubject[]
  feeRules FeeRule[]
}

model Room {
  id       String         @id @default(cuid())
  name     String         @unique
  capacity Int
  groups   Group[]
  slots    ScheduleSlot[]
}

enum PayMode {
  HORAIRE // taux × heures de cours tenues
  MENSUEL // forfait mensuel
  POURCENTAGE // % des mensualités encaissées sur ses groupes
  PAR_SEANCE // montant par séance tenue
}

model Teacher {
  id           String                @id @default(cuid())
  firstName    String
  lastName     String
  phone        String
  email        String?
  payMode      PayMode               @default(HORAIRE)
  // millimes/heure, millimes/mois, ou pourcentage (0-100)
  payRate      Int                   @default(0)
  active       Boolean               @default(true)
  notes        String?
  isDemo       Boolean               @default(false)
  subjects     TeacherSubject[]
  cycles       TeacherCycle[]
  availability TeacherAvailability[]
  groups       Group[]
  pays         TeacherPay[]
  user         User?
  createdAt    DateTime              @default(now())
}

model TeacherCycle {
  teacherId String
  cycleId   String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  cycle     Cycle   @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@id([teacherId, cycleId])
}

// Disponibilités hebdomadaires déclarées par l'enseignant
model TeacherAvailability {
  id        String  @id @default(cuid())
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  weekday   Int // 1 = lundi … 7 = dimanche
  startMin  Int
  endMin    Int

  @@index([teacherId])
}

model TeacherSubject {
  teacherId String
  subjectId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([teacherId, subjectId])
}

model Group {
  id              String              @id @default(cuid())
  name            String
  schoolYearId    String
  schoolYear      SchoolYear          @relation(fields: [schoolYearId], references: [id])
  levelId         String
  level           Level               @relation(fields: [levelId], references: [id])
  subjectId       String
  subject         Subject             @relation(fields: [subjectId], references: [id])
  teacherId       String?
  teacher         Teacher?            @relation(fields: [teacherId], references: [id])
  roomId          String?
  room            Room?               @relation(fields: [roomId], references: [id])
  capacity        Int                 @default(12)
  monthlyFee      Int // millimes
  registrationFee Int                 @default(0)
  active          Boolean             @default(true)
  isDemo          Boolean             @default(false)
  enrollments     Enrollment[]
  slots           ScheduleSlot[]
  sessions        AttendanceSession[]
  assessments     Assessment[]
  createdAt       DateTime            @default(now())

  @@unique([schoolYearId, name])
}

model ScheduleSlot {
  id       String @id @default(cuid())
  groupId  String
  group    Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  roomId   String
  room     Room   @relation(fields: [roomId], references: [id])
  weekday  Int // 1 = lundi … 7 = dimanche
  startMin Int // minutes depuis minuit
  endMin   Int

  @@index([weekday])
}

// ───────────── Élèves ─────────────

enum Gender {
  M
  F
}

enum StudentStatus {
  PREINSCRIT
  ACTIF
  SUSPENDU
  ARCHIVE
}

model Student {
  id           String             @id @default(cuid())
  code         String             @unique // VA-2026-0001
  firstName    String
  lastName     String
  fullNameAr   String?
  birthDate    DateTime?
  gender       Gender?
  school       String?
  className    String? // classe fréquentée à l'école (ex. « 9e B »)
  levelId      String?
  level        Level?             @relation(fields: [levelId], references: [id])
  phone        String?
  address      String?
  medicalNotes String?
  notes        String?
  status       StudentStatus      @default(ACTIF)
  archivedAt   DateTime?
  isDemo       Boolean            @default(false)
  guardians    StudentGuardian[]
  enrollments  Enrollment[]
  payments     Payment[]
  attendance   AttendanceRecord[]
  grades       Grade[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([lastName, firstName])
}

model Guardian {
  id         String            @id @default(cuid())
  firstName  String
  lastName   String
  phone      String
  phone2     String?
  email      String?
  profession String?
  cin        String?
  isDemo     Boolean           @default(false)
  students   StudentGuardian[]
  createdAt  DateTime          @default(now())

  @@index([phone])
}

model StudentGuardian {
  studentId   String
  guardianId  String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian    Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  relation    String // Père, Mère, Tuteur…
  isEmergency Boolean  @default(true)
  isPayer     Boolean  @default(false)

  @@id([studentId, guardianId])
}

enum EnrollmentStatus {
  ACTIVE
  TERMINEE
}

model Enrollment {
  id              String           @id @default(cuid())
  studentId       String
  student         Student          @relation(fields: [studentId], references: [id])
  groupId         String
  group           Group            @relation(fields: [groupId], references: [id])
  startDate       DateTime
  endDate         DateTime?
  baseFee         Int              @default(0) // tarif du groupe au moment de l'inscription
  monthlyFee      Int // tarif appliqué après remise
  discountTypeId  String?
  discountType    DiscountType?    @relation(fields: [discountTypeId], references: [id])
  discountPercent Int              @default(0)
  discountNote    String?
  plan            PaymentPlan      @default(MENSUEL)
  status          EnrollmentStatus @default(ACTIVE)
  invoices        Invoice[]
  createdAt       DateTime         @default(now())

  @@unique([studentId, groupId])
}

// Échéancier choisi à l'inscription
enum PaymentPlan {
  MENSUEL
  TRIMESTRIEL
  ANNUEL
}

// Grille tarifaire : la règle la plus précise s'applique (niveau+matière > niveau > cycle+matière > matière > cycle > année)
model FeeRule {
  id              String     @id @default(cuid())
  schoolYearId    String
  schoolYear      SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  cycleId         String?
  cycle           Cycle?     @relation(fields: [cycleId], references: [id])
  levelId         String?
  level           Level?     @relation(fields: [levelId], references: [id])
  subjectId       String?
  subject         Subject?   @relation(fields: [subjectId], references: [id])
  monthlyFee      Int
  registrationFee Int        @default(0)
  createdAt       DateTime   @default(now())

  @@index([schoolYearId])
}

// Moyens de paiement configurables (espèces, chèque, virement, D17…)
model PaymentMode {
  id                String       @id @default(cuid())
  code              String       @unique
  label             String
  requiresReference Boolean      @default(false)
  active            Boolean      @default(true)
  order             Int          @default(0)
  payments          Payment[]
  expenses          Expense[]
  teacherPays       TeacherPay[]
}

// Réductions autorisées, configurées par l'administration
model DiscountType {
  id          String       @id @default(cuid())
  name        String       @unique // Fratrie, Bourse, Fidélité…
  percent     Int // 1-100
  active      Boolean      @default(true)
  enrollments Enrollment[]
}

// ───────────── Finances ─────────────

enum InvoiceKind {
  MENSUALITE
  INSCRIPTION
}

model Invoice {
  id           String              @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment          @relation(fields: [enrollmentId], references: [id])
  kind         InvoiceKind         @default(MENSUALITE)
  period       String // "AAAA-MM" (1er mois couvert) ou "INSCRIPTION"
  months       Int                 @default(1) // nombre de mois couverts (trimestre = 3)
  amount       Int
  dueDate      DateTime
  // Une échéance n'est jamais supprimée : elle est annulée (sortie, changement de tarif ou d'échéancier)
  cancelledAt  DateTime?
  cancelReason String?
  allocations  PaymentAllocation[]
  createdAt    DateTime            @default(now())

  @@index([enrollmentId, period])
  @@index([dueDate])
}

model Payment {
  id           String              @id @default(cuid())
  receiptNo    String              @unique
  studentId    String
  student      Student             @relation(fields: [studentId], references: [id])
  schoolYearId String
  schoolYear   SchoolYear          @relation(fields: [schoolYearId], references: [id])
  amount       Int
  modeId       String
  mode         PaymentMode         @relation(fields: [modeId], references: [id])
  reference    String?
  paidAt       DateTime
  note         String?
  createdById  String?
  cancelledAt  DateTime?
  cancelReason String?
  // Correction : le nouveau reçu pointe vers celui qu'il remplace (annulé, jamais supprimé)
  correctsId   String?             @unique
  corrects     Payment?            @relation("PaymentCorrection", fields: [correctsId], references: [id])
  correctedBy  Payment?            @relation("PaymentCorrection")
  allocations  PaymentAllocation[]
  createdAt    DateTime            @default(now())

  @@index([paidAt])
}

model PaymentAllocation {
  id        String  @id @default(cuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  amount    Int
}

model ExpenseCategory {
  id       String    @id @default(cuid())
  name     String    @unique
  expenses Expense[]
}

model Expense {
  id           String              @id @default(cuid())
  schoolYearId String
  schoolYear   SchoolYear          @relation(fields: [schoolYearId], references: [id])
  categoryId   String
  category     ExpenseCategory     @relation(fields: [categoryId], references: [id])
  label        String
  amount       Int
  modeId       String
  mode         PaymentMode         @relation(fields: [modeId], references: [id])
  reference    String?
  spentAt      DateTime
  isDemo       Boolean             @default(false)
  createdById  String?
  // Annulation tracée (jamais de suppression) ; une correction crée une nouvelle dépense liée
  cancelledAt  DateTime?
  cancelReason String?
  correctsId   String?             @unique
  corrects     Expense?            @relation("ExpenseCorrection", fields: [correctsId], references: [id])
  correctedBy  Expense?            @relation("ExpenseCorrection")
  teacherPayId String?             @unique
  teacherPay   TeacherPay?         @relation(fields: [teacherPayId], references: [id])
  attachments  ExpenseAttachment[]
  createdAt    DateTime            @default(now())

  @@index([spentAt])
}

// Justificatif (facture, ticket…) stocké hors du dossier public, servi après contrôle des droits
model ExpenseAttachment {
  id           String   @id @default(cuid())
  expenseId    String
  expense      Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  fileName     String
  storedName   String   @unique
  mimeType     String
  size         Int
  uploadedById String?
  createdAt    DateTime @default(now())
}

// ───────────── Rémunérations enseignants ─────────────

enum TeacherPayStatus {
  BROUILLON
  VALIDE
  PAYE
  ANNULE
}

model TeacherPay {
  id             String           @id @default(cuid())
  teacherId      String
  teacher        Teacher          @relation(fields: [teacherId], references: [id])
  period         String // "AAAA-MM"
  payMode        PayMode
  rate           Int // millimes (HORAIRE, MENSUEL, PAR_SEANCE) ou % (POURCENTAGE)
  quantity       Int // minutes (HORAIRE), séances (PAR_SEANCE), assiette en millimes (POURCENTAGE), 1 (MENSUEL)
  computedAmount Int
  adjustment     Int              @default(0)
  adjustmentNote String?
  amount         Int // computedAmount + adjustment
  details        Json?
  status         TeacherPayStatus @default(BROUILLON)
  validatedById  String?
  validatedAt    DateTime?
  paidAt         DateTime?
  modeId         String?
  mode           PaymentMode?     @relation(fields: [modeId], references: [id])
  cancelledAt    DateTime?
  cancelReason   String?
  expense        Expense?
  createdById    String?
  createdAt      DateTime         @default(now())

  @@index([teacherId, period])
}

// ───────────── Notifications & messages ─────────────

enum NotificationType {
  NOUVEL_INSCRIT
  PAIEMENT
  ABSENCE
  ECHEANCE
  RETARD
  JUSTIFICATIF
  SYSTEME
}

enum NotificationStatus {
  NOUVELLE
  LUE
  TRAITEE
}

model Notification {
  id          String             @id @default(cuid())
  type        NotificationType
  title       String
  body        String?
  href        String?
  permission  String // permission requise pour la voir (ex. payments.read)
  teacherId   String? // si renseigné : visible aussi par cet enseignant (ses groupes)
  dedupeKey   String?            @unique // évite les doublons des alertes générées automatiquement
  status      NotificationStatus @default(NOUVELLE)
  readAt      DateTime?
  handledAt   DateTime?
  handledById String?
  handledNote String?
  createdAt   DateTime           @default(now())

  @@index([status, createdAt])
}

enum MessageAudience {
  PARENT
  ENSEIGNANT
}

// Seul MANUEL est actif (texte à copier / lien WhatsApp ouvert par l'utilisateur). SMS, WHATSAPP_API et EMAIL sont
// prévus par l'architecture (src/server/messaging) mais désactivés tant qu'aucun fournisseur n'est configuré et autorisé.
enum MessageChannel {
  MANUEL
  SMS
  WHATSAPP_API
  EMAIL
}

enum MessageStatus {
  PREPARE
  ENVOYE
  ANNULE
  ECHEC
}

model MessageTemplate {
  id       String          @id @default(cuid())
  code     String          @unique
  name     String
  audience MessageAudience
  body     String
  active   Boolean         @default(true)
  messages Message[]
}

model Message {
  id             String           @id @default(cuid())
  batchId        String?
  templateId     String?
  template       MessageTemplate? @relation(fields: [templateId], references: [id])
  audience       MessageAudience
  channel        MessageChannel   @default(MANUEL)
  recipientName  String
  recipientPhone String?
  studentId      String?
  guardianId     String?
  teacherId      String?
  body           String
  status         MessageStatus    @default(PREPARE)
  error          String?
  createdById    String?
  createdAt      DateTime         @default(now())
  sentAt         DateTime?
  sentById       String?

  @@index([batchId])
  @@index([status, createdAt])
}

// ───────────── Présences & notes ─────────────

enum AttendanceStatus {
  PRESENT
  ABSENT
  RETARD
  EXCUSE
}

model AttendanceSession {
  id      String             @id @default(cuid())
  groupId String
  group   Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  date    DateTime           @db.Date
  topic   String?
  records AttendanceRecord[]

  @@unique([groupId, date])
}

model AttendanceRecord {
  id        String            @id @default(cuid())
  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String
  student   Student           @relation(fields: [studentId], references: [id])
  status    AttendanceStatus
  note      String? // motif / justificatif

  @@unique([sessionId, studentId])
}

enum AssessmentKind {
  DEVOIR
  TEST
  EXAMEN_BLANC
  ORAL
}

model Assessment {
  id          String         @id @default(cuid())
  groupId     String
  group       Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title       String
  kind        AssessmentKind @default(DEVOIR)
  term        Int            @default(1) // trimestre 1-3
  date        DateTime       @db.Date
  coefficient Int            @default(1)
  maxScore    Int            @default(20)
  grades      Grade[]
  createdAt   DateTime       @default(now())
}

model Grade {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id])
  score        Float?
  comment      String?

  @@unique([assessmentId, studentId])
}
