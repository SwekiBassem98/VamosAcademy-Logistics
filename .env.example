# VAMOS ACADEMY — variables d'environnement (copier vers .env et adapter ; ne jamais committer .env)

# Base PostgreSQL (utilisateur dédié, mot de passe fort)
DATABASE_URL="postgresql://vamos:CHANGER_MOT_DE_PASSE@localhost:5432/vamos_gestion?schema=public"

# Dossier privé des justificatifs de dépenses (hors du dossier public ; à inclure dans les sauvegardes)
STORAGE_DIR="/var/lib/vamos/storage"

# Production : HTTPS obligatoire (cookie de session « Secure »).
# COOKIE_SECURE=false uniquement pour tester la version de production en local sans HTTPS.
# COOKIE_SECURE=false

# Sauvegardes (scripts/backup.sh)
BACKUP_DIR="/var/backups/vamos"
KEEP_DAYS=30

# ─── Développement et tests uniquement (jamais en production) ───
# Compte admin local créé par le seed (changement de mot de passe non forcé) :
# DEV_ADMIN_PASSWORD="choisir-un-mot-de-passe-local"
# Base des tests d'intégration (nom terminé par _test, VIDÉE à chaque exécution) :
# TEST_DATABASE_URL="postgresql://USER@localhost:5432/vamos_gestion_test?schema=public"
# Base des tests navigateur Playwright (nom terminé par _test, VIDÉE à chaque exécution) :
# E2E_DATABASE_URL="postgresql://USER@localhost:5432/vamos_e2e_test?schema=public"
